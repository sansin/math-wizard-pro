{
  "name": "math-wizard-pro",
  "version": "2.0.0",
  "private": true,
  "description": "AI-powered adaptive math learning platform — v2 (Math Wizard Pro)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "supabase:gen-types": "supabase gen types typescript --local > src/types/supabase.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,md}\"",
    "validate": "npm run typecheck && npm run lint && npm run test",
    "seed:cache": "tsx scripts/seed-cache.ts",
    "seed:cache:dry": "tsx scripts/seed-cache.ts --dryRun",
    "seed:curated": "tsx scripts/upload-curated-questions.ts",
    "seed:curated:dry": "tsx scripts/upload-curated-questions.ts --dry",
    "audit:questions": "tsx scripts/audit-questions.ts",
    "audit:questions:all": "tsx scripts/audit-questions.ts --all --reaudit-all",
    "audit:fix": "tsx scripts/audit-questions.ts --all --fix",
    "audit:fix:dry": "tsx scripts/audit-questions.ts --all --fixDry",
    "audit:fix:full": "tsx scripts/audit-questions.ts --all --fix --reaudit-all",
    "ship:check": "npm run audit:fix && echo '\\n✅ Pool is ship-ready'"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.0",
    "katex": "^0.16.11",
    "mathjs": "^15.2.0",
    "next": "^16.2.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.7.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "tsx": "^4.19.2",
    "dotenv": "^16.4.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.2.4",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.10",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
