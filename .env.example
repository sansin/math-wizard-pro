# ─── Supabase ─────────────────────────────────────────────────────────
# Public — safe to expose in browser bundle
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# Server-only — NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# ─── Encryption ───────────────────────────────────────────────────────
# Used to encrypt user-supplied API keys at rest. 32-byte hex string.
# Generate with: openssl rand -hex 32
KEY_ENCRYPTION_SECRET=your_64_char_hex_string

# ─── AI Providers (Admin / shared keys) ───────────────────────────────
# All optional. The app works without any keys (curated bank only).
# Adding ANY key enables AI generation for users without their own keys.
# Recommended order of provisioning by free-tier generosity:

# Google Gemini — most generous free tier (1500 req/day on Flash)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model override. Default is `gemini-2.0-flash` (free-tier friendly:
# 15 RPM, 1500 RPD). Set to `gemini-2.5-flash` if you have billing enabled
# and want the newer/smarter model (free tier on 2.5-flash is much tighter:
# 10 RPM, 250 RPD).
# GEMINI_MODEL=gemini-2.0-flash

# Groq — free tier with Llama 3.1, very fast
# Get key: https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras — free tier, fastest inference on the planet
# Get key: https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Anthropic Claude — best math reasoning, requires payment method
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI — broad coverage, requires payment method
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# DeepSeek — extremely cheap, strong at math
# Get key: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ─── Free-tier additional providers ───────────────────────────────────

# Cloudflare Workers AI — free Llama 3.3 70B on the edge.
# Needs BOTH an account ID and an API token (Workers AI Read scope).
# Get them: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# OpenRouter — one key, hundreds of models. Free tier on ":free" models.
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Mistral La Plateforme — free experimental tier on Mistral Small.
# Get key: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# Hugging Face Inference Providers — free Llama via the HF router.
# Get token: https://huggingface.co/settings/tokens (Read scope)
HUGGINGFACE_API_KEY=
# HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# ─── Admin ────────────────────────────────────────────────────────────
# Email of the super-admin who can disable shared-key access for users.
# Comma-separated for multiple admins.
SUPER_ADMIN_EMAILS=singarapu.sandeep@gmail.com

# Globally disable shared keys (force all users to BYOK).
DISABLE_SHARED_KEYS=false

# Provider priority order. Comma-separated, providers not listed are
# appended in default order (so they're still tried as fallbacks).
# Default: free-tier-first → gemini, groq, cerebras, claude, deepseek, openai.
# Tip: put your free-tier providers first so paid keys are only consumed
# when the free quotas are exhausted.
# AI_PROVIDER_ORDER=gemini,groq,cerebras,deepseek,openai,claude

# ─── Feature Flags ────────────────────────────────────────────────────
NEXT_PUBLIC_V1_URL=https://sansin.github.io/math-wizard
NEXT_PUBLIC_ENABLE_MIGRATION=true

# ─── Build mode ───────────────────────────────────────────────────────
# Set to 'true' for static export (Cloudflare Pages, GH Pages)
# Leave unset for server-rendered (Vercel/Cloudflare Pages with Functions)
STATIC_EXPORT=false
